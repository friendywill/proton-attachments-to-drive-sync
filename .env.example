# Copy to .env and fill in. .env is gitignored.

# Credentials generated BY Proton Mail Bridge for local IMAP clients.
# These are not your Proton account password.
IMAP_USERNAME=you@proton.me
IMAP_PASSWORD=bridge-generated-password

# Path (inside the app container) to the bridge TLS certificate.
# Confirm the exact filename against the bridge image before enabling.
# IMAP_CERT_PATH=/bridge/.config/protonmail/bridge-v3/cert.pem

# Mailbox holding sent mail, as the bridge exposes it. Only needed if the
# bridge does not tag it with the \Sent attribute.
SENT_FOLDER_NAME=Sent

# Every other mailbox is scanned. Comma-separated names to skip; setting this
# replaces the default list below rather than adding to it. "All Mail",
# "Starred" and everything under "Labels/" only re-list mail that is already
# scanned in its own folder, so leave them excluded.
# EXCLUDED_MAILBOXES=Snoozed,Trash,Spam,Drafts,All Mail,Starred

POLL_INTERVAL_SECONDS=60
LOG_LEVEL=INFO

# rclone remote configured for the protondrive backend.
DRIVE_REMOTE_NAME=protondrive
DRIVE_ROOT_PATH=My Files/Proton Mail Attachments
